NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Required for production builds; optional for local development.
# Use an owner-reviewed release package; URL is embedded at build time.
# NEXT_PUBLIC_STUDENT_PACKAGE_URL=/data/student-data-<export_id>.json
# Development-only synthetic preview; production always rejects test packages.
# NEXT_PUBLIC_ALLOW_TEST_PACKAGE=true
